{
  "name": "capto-screen-recorder",
  "version": "1.0.0",
  "description": "Cross-platform Free & Open-Source Screen Recorder for Windows, macOS & Linux with Glassmorphism UI, Dual Mode, Free Noise Removal, Brightness Control & Silence Trimming",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hari92004/Capto_screen_recoder.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -wml",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "capto",
    "screen-recorder",
    "webcam-recorder",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "open-source",
    "electron",
    "noise-suppression",
    "silence-removal",
    "brightness-control",
    "glassmorphism"
  ],
  "author": "Hari",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.capto.screenrecorder",
    "productName": "Capto",
    "executableName": "Capto",
    "copyright": "Copyright © 2026 Hari",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Capto Screen Recorder",
      "artifactName": "Capto-Setup.${ext}",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "category": "AudioVideo;Recorder;",
      "maintainer": "Hari"
    }
  },
  "dependencies": {
    "@shiguredo/rnnoise-wasm": "^2025.1.5"
  }
}
